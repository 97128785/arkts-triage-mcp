{
  "name": "arkts-triage-mcp",
  "version": "0.1.0",
  "description": "Local-first MCP server for evidence-based HarmonyOS and ArkTS build triage.",
  "type": "module",
  "bin": {
    "arkts-triage-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke-client.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "arkts",
    "harmonyos",
    "hvigor",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "homepage": "https://github.com/97128785/arkts-triage-mcp#readme",
  "bugs": {
    "url": "https://github.com/97128785/arkts-triage-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/97128785/arkts-triage-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "json5": "2.2.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
